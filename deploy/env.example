# Copy to .env for Docker Compose; generate 64 hex characters for the password.
POSTGRES_PASSWORD=
SITE_DOMAIN=
APP_VERSION=local
# Optional hosts separated by comma and space that redirect to SITE_DOMAIN (e.g. www.example.com).
SITE_REDIRECT_DOMAINS=
# Resend sending-only key; never commit a real value. Use deploy/init-env.py for MAIL_TOKEN_KEY.
RESEND_API_KEY=
EMAIL_FROM=ФСП Карьера <no-reply@fspcareer.space>
MAIL_TOKEN_KEY=
