# Copy to .env for Docker Compose; generate 64 hex characters for the password.
POSTGRES_PASSWORD=
SITE_DOMAIN=
APP_VERSION=local
# Optional hosts separated by comma and space that redirect to SITE_DOMAIN (e.g. www.example.com).
SITE_REDIRECT_DOMAINS=
# Resend sending-only key; never commit a real value. Use deploy/init-env.py for MAIL_TOKEN_KEY.
RESEND_API_KEY=
EMAIL_FROM=ФСП Карьера <no-reply@fspcareer.space>
MAIL_TOKEN_KEY=

# Comma-separated account IDs allowed to administer questions and sessions.
TEST_MAINTAINER_IDS=

# Private Docker worker for coding assessments; same token on both hosts (32+ characters).
# Use HTTPS between hosts. See docs/coding-and-role-grades.md.
CODE_SANDBOX_URL=
CODE_SANDBOX_TOKEN=
