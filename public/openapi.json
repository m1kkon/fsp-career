      "fsp-link": {
        "type": "object",
        "description": "Привязать тестовый ФСП ID к своему кандидату. Реестр не вызывается; принадлежность реального ID не подтверждается.",
        "properties": {
          "action": {
            "type": "string",
            "const": "fsp-link"
          },
          "fspId": {
            "type": "string",
            "pattern": "^DEMO-FSP-00[1-8]$",
            "example": "DEMO-FSP-001"
          }
        },
        "required": [
          "action",
          "fspId"
        ]
      },
      "fsp-unlink": {
        "type": "object",
        "description": "Отвязать тестовый ID, сохранив резюме и категорию.",
        "properties": {
          "action": {
            "type": "string",
            "const": "fsp-unlink"
          }
        },
        "required": [
          "action"
        ]
      },
      "FspProfile": {
        "type": [
          "object",
          "null"
        ],
        "description": "Только синтетические fixture-данные; null при отсутствующей или скрытой истории. Не означает реальную проверку ФСП.",
        "properties": {
